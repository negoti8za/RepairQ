<?xml version="1.0" encoding="UTF-8"?>

<?xml-model href="http://javafx.com/fxml/1"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/11.0.1"?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.repairq.controller.LoginController"
            prefHeight="200.0" prefWidth="300.0">
   <center>
      <VBox alignment="CENTER" spacing="10.0">
         <children>
            <Label text="RepairQ Login" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <TextField fx:id="usernameField" promptText="Username" />
            <PasswordField fx:id="passwordField" promptText="Password" />
            <Button fx:id="loginButton" text="Login" onAction="#handleLogin" />
         </children>
      </VBox>
   </center>
</BorderPane>